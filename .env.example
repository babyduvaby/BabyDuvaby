# ==============================================
# Firebase (existente)
# ==============================================
NEXT_PUBLIC_ADMIN_EMAIL=tu-email-admin@dominio.com
NEXT_PUBLIC_ADMIN_EMAILS=tu-email-admin@dominio.com
NEXT_PUBLIC_ADMIN_PASSWORD_FALLBACK=clave-emergencia

# ==============================================
# Cloudinary (existente - optimización de imágenes)
# ==============================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu-upload-preset-unsigned
NEXT_PUBLIC_CLOUDINARY_DYNAMIC_FOLDER=0

# ==============================================
# Payload CMS 3.0
# ==============================================
PAYLOAD_SECRET=tu-secret-key-super-seguro-cambiar-en-produccion
NEXT_PUBLIC_PAYLOAD_URL=https://baby-duvaby.vercel.app/api
NEXT_PUBLIC_SITE_URL=https://baby-duvaby.vercel.app

# ==============================================
# Supabase - PostgreSQL Database
# ==============================================
# Connection string de Supabase (Settings > Database > Connection string > URI)
# Formato: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URI=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres

# ==============================================
# Supabase - Storage & Auth
# ==============================================
# Project URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co

# Clave pública anon (Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Service role key - SOLO servidor (Settings > API > Project API keys > service_role secret)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ==============================================
# Supabase Storage - Buckets (se crean automáticamente)
# ==============================================
# Bucket principal para archivos de Payload CMS: payload-media
# Los buckets se crean automáticamente al primer upload.
# Para configurar manualmente: Supabase Dashboard > Storage > New bucket
#   - Nombre: payload-media
#   - Public: YES (para URLs públicas de imágenes)
#   - File size limit: 10MB
#   - Allowed MIME types: image/png, image/jpeg, image/gif, image/webp, image/svg+xml
